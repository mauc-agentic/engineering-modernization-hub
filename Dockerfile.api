# Imagen de la API (ADR-006, ECS Fargate). Build:
#   docker build -f Dockerfile.api -t emh-api .

FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml ./
COPY emh/ emh/

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "emh.api.app:app_factory", "--factory", "--host", "0.0.0.0", "--port", "8000"]
